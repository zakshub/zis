{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/ZOSMigrationCandidate.schema.json",
  "title": "ZIS ZOS Migration Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source_id", "candidate_type", "content", "scope", "confidence", "privacy_status", "identity_scrub_status", "privacy_findings", "specialist_status", "specialist_domains", "temporal_status", "observed_at", "valid_from", "valid_until", "contradiction_candidate_ids", "transformation_notes", "review_status", "review_note", "reviewed_at", "import_status", "evidence_id", "created_at", "updated_at", "migration_version"],
  "properties": {
    "id": {"type": "string", "pattern": "^zcand_[a-f0-9]{20}$"},
    "source_id": {"type": "string", "pattern": "^zsrc_[a-f0-9]{20}$"},
    "candidate_type": {"enum": ["direct_statement", "observation", "inferred_cognitive_pattern", "rule_principle", "historical_preference", "decision_pattern", "writing_communication_pattern", "uncertainty", "contradiction", "obsolete_claim"]},
    "content": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["unknown", "weak", "probable", "strong", "established"]},
    "privacy_status": {"enum": ["review_required", "reviewed_safe", "blocked"]},
    "identity_scrub_status": {"enum": ["pending_review", "reviewed_safe", "excluded"]},
    "privacy_findings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "specialist_status": {"enum": ["none_detected", "review_required", "core_safe", "route_to_specialist"]},
    "specialist_domains": {"type": "array", "uniqueItems": true, "items": {"enum": ["designer", "studio", "seo", "taxbot", "finance", "content"]}},
    "temporal_status": {"enum": ["historical", "currently_valid", "uncertain_current_validity", "superseded", "contradicted", "obsolete"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "contradiction_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^zcand_[a-f0-9]{20}$"}},
    "transformation_notes": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "review_status": {"enum": ["pending", "approved", "rejected", "deferred", "requires_redaction", "routed_to_specialist", "obsolete"]},
    "review_note": {"type": ["string", "null"]},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "import_status": {"enum": ["not_imported", "imported", "blocked"]},
    "evidence_id": {"type": ["string", "null"], "pattern": "^ev_[a-f0-9]{20}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "migration_version": {"type": "integer", "minimum": 1}
  }
}
