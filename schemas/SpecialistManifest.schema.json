{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/SpecialistManifest.schema.json",
  "title": "ZIS SpecialistManifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "domain", "purpose", "capabilities", "input_contract", "output_contract", "interface_version", "compatible_runtime_versions", "when_to_use", "when_not_to_use", "maturity", "location", "invocation_modes", "health_check", "security_boundary", "fallback", "provenance_requirement", "owner_approval_required_for_changes", "status", "availability", "confidence", "provenance", "created_at", "updated_at", "source_references", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^sp_[a-z0-9_-]+$"},
    "name": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "input_contract": {"type": "string", "minLength": 1},
    "output_contract": {"type": "string", "minLength": 1},
    "interface_version": {"type": "string", "minLength": 1},
    "compatible_runtime_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "when_to_use": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "when_not_to_use": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "maturity": {"enum": ["unknown", "experimental", "working", "established", "retired"]},
    "location": {"type": "string", "minLength": 1},
    "invocation_modes": {"type": "array", "items": {"enum": ["manual", "cli", "http", "repository"]}},
    "health_check": {"type": ["string", "null"]},
    "security_boundary": {"type": "string", "minLength": 1},
    "fallback": {"type": "string", "minLength": 1},
    "provenance_requirement": {"type": "string", "minLength": 1},
    "owner_approval_required_for_changes": {"type": "boolean"},
    "status": {"enum": ["proposed", "approved", "available", "unavailable", "retired"]},
    "availability": {"enum": ["unknown", "available", "unavailable"]},
    "confidence": {"enum": ["unknown", "weak", "probable", "strong", "established"]},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "actor", "chain"], "properties": {"method": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "source_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "version": {"type": "integer", "minimum": 1}
  }
}
