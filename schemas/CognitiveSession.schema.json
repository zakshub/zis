{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/CognitiveSession.schema.json",
  "title": "ZIS CognitiveSession v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "trigger_reference", "scope", "evidence_ids", "memory_ids", "effective_at", "started_at", "completed_at", "status", "ruleset_version", "input_fingerprint", "state_fingerprint", "artifact_ids", "provenance", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^cog_[a-f0-9]{20}$"},
    "trigger_reference": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ev_[a-f0-9]{20}$"}},
    "memory_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^mem_[a-f0-9]{20}$"}},
    "effective_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "status": {"enum": ["running", "completed", "failed"]},
    "ruleset_version": {"type": "string", "minLength": 1},
    "input_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "state_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "actor", "chain"], "properties": {"method": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "version": {"type": "integer", "minimum": 1}
  }
}
