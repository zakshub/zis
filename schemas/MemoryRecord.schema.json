{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/MemoryRecord.schema.json",
  "title": "ZIS MemoryRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "memory_type", "content", "source_evidence_ids", "scope", "status", "confidence", "conflict_status", "valid_from", "valid_until", "current_interpretation", "approval_id", "provenance", "created_at", "updated_at", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^mem_[a-f0-9]{20}$"},
    "memory_type": {"enum": ["core_principle", "pattern", "preference", "project", "evidence_backed", "experimental"]},
    "content": {"type": "string", "minLength": 1},
    "source_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^ev_[a-f0-9]{20}$"}},
    "scope": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "active", "superseded", "rejected", "expired", "deprecated"]},
    "confidence": {"enum": ["unknown", "weak", "probable", "strong", "established"]},
    "conflict_status": {"enum": ["none", "unresolved", "resolved"]},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "current_interpretation": {"type": "boolean"},
    "approval_id": {"type": "string", "pattern": "^apr_[a-f0-9]{20}$"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "actor", "chain"], "properties": {"method": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  }
}
