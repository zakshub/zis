{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/EvidenceRecord.schema.json",
  "title": "ZIS EvidenceRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "record_type", "content", "source", "source_references", "observed_at", "recorded_at", "valid_from", "valid_until", "scope", "status", "confidence", "provenance", "privacy_class", "supersedes", "superseded_by", "current_interpretation", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^ev_[a-f0-9]{20}$"},
    "record_type": {"enum": ["observation", "user_statement", "external_fact", "inference", "hypothesis", "correction", "derived_pattern"]},
    "content": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "reference"],
      "properties": {"type": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1}}
    },
    "source_references": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observed_at": {"type": "string", "format": "date-time"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "status": {"enum": ["captured", "reviewed", "promoted", "superseded", "rejected", "expired"]},
    "confidence": {"enum": ["unknown", "weak", "probable", "strong", "established"]},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "actor", "chain"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "privacy_class": {"enum": ["public", "internal", "private", "restricted"]},
    "supersedes": {"type": ["string", "null"], "pattern": "^ev_[a-f0-9]{20}$"},
    "superseded_by": {"type": ["string", "null"], "pattern": "^ev_[a-f0-9]{20}$"},
    "current_interpretation": {"type": "boolean"},
    "version": {"type": "integer", "minimum": 1}
  }
}
