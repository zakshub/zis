{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/AssociationRecord.schema.json",
  "title": "ZIS AssociationRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "session_id", "from_type", "from_id", "to_type", "to_id", "relation_type", "reason", "supporting_references", "strength", "status", "provenance", "created_at", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^assoc_[a-f0-9]{20}$"},
    "session_id": {"type": "string", "pattern": "^cog_[a-f0-9]{20}$"},
    "from_type": {"enum": ["evidence", "memory", "pattern", "hypothesis", "idea"]},
    "from_id": {"type": "string", "minLength": 1},
    "to_type": {"enum": ["evidence", "memory", "pattern", "hypothesis", "idea"]},
    "to_id": {"type": "string", "minLength": 1},
    "relation_type": {"enum": ["shared_source", "shared_scope", "shared_tag", "repeated_occurrence", "known_contradiction", "contradiction_candidate", "explicit_supersession", "explicit_relation"]},
    "reason": {"type": "string", "minLength": 1},
    "supporting_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "strength": {"enum": ["unknown", "weak", "probable", "strong", "established"]},
    "status": {"enum": ["known", "candidate"]},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "actor", "chain"], "properties": {"method": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "created_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  }
}
