{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/ObservationRecord.schema.json",
  "title": "ZIS ObservationRecord v2",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"observed_time_status": {"const": "known"}}, "required": ["observed_time_status"]}, "then": {"properties": {"observed_at": {"type": "string", "format": "date-time"}}}},
    {"if": {"properties": {"observed_time_status": {"const": "unknown"}}, "required": ["observed_time_status"]}, "then": {"properties": {"observed_at": {"const": null}, "valid_from": {"type": ["string", "null"], "format": "date-time"}}}}
  ],
  "required": ["id", "source_id", "collection_session_id", "adapter_id", "adapter_version", "observed_at", "observed_time_status", "recorded_at", "imported_at", "valid_from", "valid_until", "scope", "observation_type", "data_class", "content", "structured_payload", "source_reference", "explicit_event_id", "provenance", "privacy_class", "capture_confidence", "subject_labels", "context_labels", "review_state", "retention_state", "retention_expires_at", "content_fingerprint", "identity_status", "secret_status", "linked_evidence_ids", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^obs_[a-f0-9]{20}$"},
    "source_id": {"type": "string", "pattern": "^osrc_[a-f0-9]{20}$"},
    "collection_session_id": {"type": "string", "pattern": "^ocsession_[a-f0-9]{20}$"},
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "observed_at": {"type": ["string", "null"], "format": "date-time"},
    "observed_time_status": {"enum": ["known", "unknown"]},
    "recorded_at": {"type": "string", "format": "date-time"},
    "imported_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": ["string", "null"], "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "observation_type": {"enum": ["observation", "note", "behavioral_occurrence", "preference_expression", "contextual_event", "file_content", "other"]},
    "data_class": {"type": "string", "minLength": 1},
    "content": {"type": ["string", "null"]},
    "structured_payload": {"type": ["object", "null"]},
    "source_reference": {"type": "string", "minLength": 1},
    "explicit_event_id": {"type": ["string", "null"]},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_id", "collection_session_id", "adapter_id", "adapter_version", "source_reference", "ingestion_method", "transformation_notes", "original_privacy_class"], "properties": {"source_id": {"type": "string", "pattern": "^osrc_[a-f0-9]{20}$"}, "collection_session_id": {"type": "string", "pattern": "^ocsession_[a-f0-9]{20}$"}, "adapter_id": {"type": "string", "minLength": 1}, "adapter_version": {"type": "string", "minLength": 1}, "source_reference": {"type": "string", "minLength": 1}, "ingestion_method": {"type": "string", "minLength": 1}, "transformation_notes": {"type": "array", "items": {"type": "string", "minLength": 1}}, "original_privacy_class": {"enum": ["public", "internal", "private", "restricted"]}}},
    "privacy_class": {"enum": ["public", "internal", "private", "restricted"]},
    "capture_confidence": {"enum": ["unknown", "weak", "probable", "strong", "established"]},
    "subject_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "context_labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "review_state": {"enum": ["captured", "review_pending", "accepted_for_evidence_review", "rejected", "quarantined", "expired", "deleted_marker"]},
    "retention_state": {"enum": ["active", "expired", "quarantined", "purged"]},
    "retention_expires_at": {"type": ["string", "null"], "format": "date-time"},
    "content_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "identity_status": {"enum": ["not_detected", "reviewed_safe", "retained_private", "excluded"]},
    "secret_status": {"enum": ["none_detected", "suspected_quarantined"]},
    "linked_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ev_[a-f0-9]{20}$"}},
    "version": {"type": "integer", "minimum": 1}
  }
}
