{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/CapabilityRecord.schema.json",
  "title": "ZIS CapabilityRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "capability_type", "status", "implementation_reference", "availability", "dependencies", "approval_required", "approval_id", "proposal_id", "privacy_impact", "security_impact", "provenance", "created_at", "updated_at", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^cr_[a-f0-9]{20}$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "capability_type": {"enum": ["classical_action", "manual_workflow", "tool_reference", "service_reference"]},
    "status": {"enum": ["proposed", "approved", "available", "unavailable", "deprecated", "retired"]},
    "implementation_reference": {"type": "string", "minLength": 1},
    "availability": {"enum": ["unknown", "available", "unavailable"]},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^cr_[a-f0-9]{20}$"}},
    "approval_required": {"type": "boolean"},
    "approval_id": {"type": ["string", "null"], "pattern": "^apr_[a-f0-9]{20}$"},
    "proposal_id": {"type": ["string", "null"], "pattern": "^cap_[a-f0-9]{20}$"},
    "privacy_impact": {"type": "string", "minLength": 1},
    "security_impact": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "actor", "chain"], "properties": {"method": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  }
}
