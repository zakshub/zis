{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/IdeaLineage.schema.json",
  "title": "ZIS IdeaLineage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "created_at", "updated_at", "origin_type", "origin_evidence_ids", "source_references", "initial_signal", "questions", "associations", "research_references", "hypotheses", "concept_versions", "evaluations", "specialists_consulted", "decisions", "approval_references", "execution_references", "outcome", "reflection", "learning_ids", "status", "provenance", "confidence", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^idea_[a-f0-9]{20}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "origin_type": {"enum": ["observation", "reading", "conversation", "irritation", "curiosity", "intuition", "analogy", "inversion", "combination", "counterfactual", "visual_stimulus", "memory", "accidental_discovery"]},
    "origin_evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^ev_[a-f0-9]{20}$"}},
    "source_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "initial_signal": {"type": "string", "minLength": 1},
    "questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "associations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "research_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "hypotheses": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "concept_versions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evaluations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "specialists_consulted": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "decisions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "approval_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "execution_references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "outcome": {"type": ["string", "null"]},
    "reflection": {"type": ["string", "null"]},
    "learning_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["spark", "unclear", "exploring", "researching", "promising", "parked", "rejected", "ready", "approved", "executing", "completed", "learned"]},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "actor", "chain"], "properties": {"method": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "confidence": {"enum": ["unknown", "weak", "probable", "strong", "established"]},
    "version": {"type": "integer", "minimum": 1}
  }
}
