{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/IdeaLineage.schema.json",
  "title": "ZIS IdeaLineage v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "session_id", "statement", "scope", "origin_type", "parent_idea_ids", "evidence_ids", "pattern_ids", "hypothesis_ids", "association_ids", "trigger", "transformations", "status", "rationale", "truth_status", "provenance", "confidence", "created_at", "updated_at", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^idea_[a-f0-9]{20}$"},
    "session_id": {"type": "string", "pattern": "^cog_[a-f0-9]{20}$"},
    "statement": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "origin_type": {"enum": ["observation", "reading", "conversation", "irritation", "curiosity", "intuition", "analogy", "inversion", "combination", "counterfactual", "visual_stimulus", "memory", "accidental_discovery"]},
    "parent_idea_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^idea_[a-f0-9]{20}$"}},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ev_[a-f0-9]{20}$"}},
    "pattern_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^pat_[a-f0-9]{20}$"}},
    "hypothesis_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^hyp_[a-f0-9]{20}$"}},
    "association_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^assoc_[a-f0-9]{20}$"}},
    "trigger": {"type": "string", "minLength": 1},
    "transformations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["spark", "unclear", "exploring", "researching", "promising", "rejected", "parked", "ready"]},
    "rationale": {"type": "string", "minLength": 1},
    "truth_status": {"const": "idea_not_truth"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "actor", "chain"], "properties": {"method": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "confidence": {"enum": ["unknown", "weak", "probable", "strong", "established"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  }
}
