{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/AIResponse.schema.json",
  "title": "ZIS AIResponse v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "request_id", "provider_id", "model_id", "adapter_version", "status", "structured_output", "text_output", "finish_reason", "usage", "cost", "latency_ms", "provider_reference", "error_category", "error_message", "output_fingerprint", "candidate_id", "provenance", "created_at", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^airesp_[a-f0-9]{20}$"},
    "request_id": {"type": "string", "pattern": "^aireq_[a-f0-9]{20}$"},
    "provider_id": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["success", "unavailable", "timeout", "provider_error", "invalid_output", "cancelled", "disabled"]},
    "structured_output": {"type": ["object", "null"]},
    "text_output": {"const": null},
    "finish_reason": {"type": ["string", "null"]},
    "usage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "total_tokens"], "properties": {"input_tokens": {"type": ["integer", "null"], "minimum": 0}, "output_tokens": {"type": ["integer", "null"], "minimum": 0}, "total_tokens": {"type": ["integer", "null"], "minimum": 0}}},
    "cost": {"type": "object", "additionalProperties": false, "required": ["status", "amount", "currency", "pricing_version", "pricing_source"], "properties": {"status": {"enum": ["unknown", "estimated", "provider_reported"]}, "amount": {"type": ["number", "null"], "minimum": 0}, "currency": {"type": ["string", "null"]}, "pricing_version": {"type": ["string", "null"]}, "pricing_source": {"type": ["string", "null"]}}},
    "latency_ms": {"type": "integer", "minimum": 0},
    "provider_reference": {"type": ["string", "null"]},
    "error_category": {"type": ["string", "null"], "enum": ["disabled", "not_configured", "authentication", "rate_limit", "provider_server", "transport", "timeout", "invalid_provider_response", "invalid_structured_output", "cancelled", "unsupported_provider", null]},
    "error_message": {"type": ["string", "null"]},
    "output_fingerprint": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
    "candidate_id": {"type": ["string", "null"], "pattern": "^aicand_[a-f0-9]{20}$"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "actor", "chain"], "properties": {"method": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "created_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  }
}
