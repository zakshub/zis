{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/ModelUpdateProposal.schema.json",
  "title": "ZIS ModelUpdateProposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "session_id", "target_memory_id", "proposed_change", "reason", "supporting_artifact_ids", "counterevidence_ids", "confidence", "impact", "status", "required_approval", "approval_id", "applied_at", "provenance", "created_at", "updated_at", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^mup_[a-f0-9]{20}$"},
    "session_id": {"type": "string", "pattern": "^cog_[a-f0-9]{20}$"},
    "target_memory_id": {"type": "string", "pattern": "^mem_[a-f0-9]{20}$"},
    "proposed_change": {"type": "string", "minLength": 1},
    "reason": {"type": "string", "minLength": 1},
    "supporting_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "counterevidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ev_[a-f0-9]{20}$"}},
    "confidence": {"enum": ["unknown", "weak", "probable", "strong", "established"]},
    "impact": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "under_review", "approved", "rejected", "applied"]},
    "required_approval": {"const": true},
    "approval_id": {"type": "string", "pattern": "^apr_[a-f0-9]{20}$"},
    "applied_at": {"type": ["string", "null"], "format": "date-time"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "actor", "chain"], "properties": {"method": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  }
}
