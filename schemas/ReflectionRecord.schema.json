{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/ReflectionRecord.schema.json",
  "title": "ZIS ReflectionRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "session_id", "considered_references", "artifact_ids", "uncertainties", "unresolved_contradiction_ids", "assumptions", "missing_evidence", "reconsiderations", "model_update_proposal_justified", "consciousness_claim", "provenance", "created_at", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^refl_[a-f0-9]{20}$"},
    "session_id": {"type": "string", "pattern": "^cog_[a-f0-9]{20}$"},
    "considered_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "uncertainties": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "unresolved_contradiction_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^con_[a-f0-9]{20}$"}},
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "missing_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reconsiderations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "model_update_proposal_justified": {"type": "boolean"},
    "consciousness_claim": {"const": false},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "actor", "chain"], "properties": {"method": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "created_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  }
}
