{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/ObservationSource.schema.json",
  "title": "ZIS ObservationSource v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "source_type", "approval_scope", "approval_id", "status", "collection_mode", "allowed_scopes", "allowed_data_classes", "denied_data_classes", "retention_policy", "external", "adapter_id", "adapter_version", "last_collection", "privacy_notes", "provenance", "created_at", "updated_at", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^osrc_[a-f0-9]{20}$"},
    "name": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["manual", "file_import", "conversation_export", "browser_export", "social_export", "application_export", "connector", "local_directory", "other"]},
    "approval_scope": {"type": "string", "minLength": 1},
    "approval_id": {"type": "string", "pattern": "^apr_[a-f0-9]{20}$"},
    "status": {"enum": ["pending", "approved", "paused", "revoked", "retired"]},
    "collection_mode": {"enum": ["explicit_single", "explicit_batch"]},
    "allowed_scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_data_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "denied_data_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "retention_policy": {"type": "object", "additionalProperties": false, "required": ["mode", "days"], "properties": {"mode": {"enum": ["manual", "session_only", "days", "indefinite_local"]}, "days": {"type": ["integer", "null"], "minimum": 1}}},
    "external": {"type": "boolean"},
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "last_collection": {"type": ["object", "null"]},
    "privacy_notes": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "actor", "chain"], "properties": {"method": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  }
}
