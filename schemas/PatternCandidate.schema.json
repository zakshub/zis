{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/PatternCandidate.schema.json",
  "title": "ZIS PatternCandidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "session_id", "description", "scope", "supporting_evidence_ids", "supporting_association_ids", "counterevidence_ids", "support_count", "confidence", "status", "valid_from", "valid_until", "rationale", "truth_status", "is_memory", "provenance", "created_at", "updated_at", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^pat_[a-f0-9]{20}$"},
    "session_id": {"type": "string", "pattern": "^cog_[a-f0-9]{20}$"},
    "description": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "supporting_evidence_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^ev_[a-f0-9]{20}$"}},
    "supporting_association_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^assoc_[a-f0-9]{20}$"}},
    "counterevidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ev_[a-f0-9]{20}$"}},
    "support_count": {"type": "integer", "minimum": 2},
    "confidence": {"enum": ["unknown", "weak", "probable", "strong", "established"]},
    "status": {"enum": ["candidate", "under_review", "supported", "rejected", "superseded"]},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "rationale": {"type": "string", "minLength": 1},
    "truth_status": {"const": "candidate_not_truth"},
    "is_memory": {"const": false},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "actor", "chain"], "properties": {"method": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "chain": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  }
}
