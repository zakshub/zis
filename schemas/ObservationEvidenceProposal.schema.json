{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/ObservationEvidenceProposal.schema.json",
  "title": "ZIS ObservationEvidenceProposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "observation_ids", "proposed_content", "proposed_evidence_type", "scope", "confidence", "observed_at", "valid_from", "valid_until", "rationale", "uncertainty", "counter_context", "status", "approval_id", "evidence_id", "provenance", "created_at", "updated_at", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^oeprop_[a-f0-9]{20}$"},
    "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^obs_[a-f0-9]{20}$"}},
    "proposed_content": {"type": "string", "minLength": 1},
    "proposed_evidence_type": {"enum": ["observation", "user_statement", "external_fact", "inference", "hypothesis", "correction", "derived_pattern"]},
    "scope": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["unknown", "weak", "probable", "strong", "established"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"},
    "valid_until": {"type": ["string", "null"], "format": "date-time"},
    "rationale": {"type": "string", "minLength": 1},
    "uncertainty": {"type": "string", "minLength": 1},
    "counter_context": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["pending_review", "approved", "rejected", "promoted"]},
    "approval_id": {"type": "string", "pattern": "^apr_[a-f0-9]{20}$"},
    "evidence_id": {"type": ["string", "null"], "pattern": "^ev_[a-f0-9]{20}$"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["method", "actor", "chain"], "properties": {"method": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "chain": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  }
}
