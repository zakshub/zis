{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zis.local/schemas/RouteDecision.schema.json",
  "title": "ZIS RouteDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "request_id", "action_type", "scope", "requested_at", "requested_action_reference", "requested_capability_id", "requested_specialist_id", "selected_route", "reason", "rules_evaluated", "capability_considered", "specialist_considered", "approval_required", "approval_id", "unsupported_reason", "state_fingerprint", "created_at", "version"],
  "properties": {
    "id": {"type": "string", "pattern": "^route_[a-f0-9]{20}$"},
    "request_id": {"type": "string", "pattern": "^task_[a-f0-9]{20}$"},
    "action_type": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "requested_at": {"type": "string", "format": "date-time"},
    "requested_action_reference": {"type": ["string", "null"]},
    "requested_capability_id": {"type": ["string", "null"], "pattern": "^cr_[a-f0-9]{20}$"},
    "requested_specialist_id": {"type": ["string", "null"], "pattern": "^sp_[a-z0-9_-]+$"},
    "selected_route": {"enum": ["no_action", "classical_runtime", "existing_capability", "specialist_candidate", "approval_required", "unsupported"]},
    "reason": {"type": "string", "minLength": 1},
    "rules_evaluated": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "capability_considered": {"type": ["string", "null"], "pattern": "^cr_[a-f0-9]{20}$"},
    "specialist_considered": {"type": ["string", "null"], "pattern": "^sp_[a-z0-9_-]+$"},
    "approval_required": {"type": "boolean"},
    "approval_id": {"type": ["string", "null"], "pattern": "^apr_[a-f0-9]{20}$"},
    "unsupported_reason": {"type": ["string", "null"]},
    "state_fingerprint": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1}
  }
}
